# Application Settings
PROJECT_NAME="AI-Powered Insider Threat Behavioral Intelligence System"
VERSION="2.0.0"
SECRET_KEY="replace-with-a-unique-random-secret-before-running"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Docker / PostgreSQL
POSTGRES_USER="soc_admin"
POSTGRES_PASSWORD="replace-with-a-strong-alphanumeric-password"
POSTGRES_DB="insider_threat_db"
DATABASE_URL="postgresql://soc_admin:replace-with-a-strong-alphanumeric-password@postgres:5432/insider_threat_db"

# Local SQLite alternative for standalone backend:
# DATABASE_URL="sqlite:///./insider_threat.db"

# Server Port
PORT=8000
HOST="0.0.0.0"
